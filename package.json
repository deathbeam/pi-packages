      "./packages/pi-combos/index.ts",
      "./packages/pi-context/index.ts",
      "./packages/pi-delegate/index.ts",
      "./packages/pi-hashline/index.ts",
      "./packages/pi-images/index.ts",
      "./packages/pi-inferhub/index.ts",
      "./packages/pi-opencode/index.ts",
      "./packages/pi-surplus/index.ts",
      "./packages/pi-keenable/index.ts",
      "./packages/pi-usage/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^26.6.6",
    "@types/xxhashjs": "^0.2.4",
    "prettier": "^3.10.1",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
